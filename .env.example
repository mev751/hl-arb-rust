# ================================================================
# Hyperliquid & Binance Credentials Configuration
# ================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
#
# DO NOT commit your .env file with real private keys to git!
# ================================================================

# Hyperliquid HIP-3 API Credentials
HL_PRIVATE_KEY=0x_YOUR_HYPERLIQUID_ETHEREUM_PRIVATE_KEY_HEX
HL_WALLET_ADDRESS=0x_YOUR_HYPERLIQUID_WALLET_ADDRESS

# Binance USDⓈ-M Futures API Credentials
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
